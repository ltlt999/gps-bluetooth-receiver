<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.GpsReceiver" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/color_primary</item>
        <item name="colorOnPrimary">#06231E</item>
        <item name="colorSecondary">@color/color_accent_blue</item>
        <item name="colorOnSecondary">#FFFFFF</item>
        <item name="colorError">@color/color_error</item>
        <item name="android:colorBackground">@color/color_background_start</item>
        <item name="colorSurface">@color/color_card</item>
        <item name="colorOnSurface">@color/color_text_primary</item>
        <item name="colorOnSurfaceVariant">@color/color_text_secondary</item>
        <item name="android:windowBackground">@color/color_background_start</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">false</item>
    </style>

    <style name="TextAppearance.GpsReceiver.Title" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textColor">@color/color_text_primary</item>
        <item name="android:letterSpacing">0.02</item>
    </style>

    <style name="TextAppearance.GpsReceiver.Body" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textColor">@color/color_text_secondary</item>
    </style>

    <style name="TextAppearance.GpsReceiver.Value" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:fontFamily">monospace</item>
        <item name="android:textColor">@color/color_text_primary</item>
    </style>

    <style name="TextAppearance.GpsReceiver.Coordinate" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:fontFamily">monospace</item>
        <item name="android:textColor">@color/color_primary</item>
    </style>

    <style name="Widget.GpsReceiver.Card" parent="">
        <item name="android:background">@drawable/card_background</item>
        <item name="android:padding">16dp</item>
    </style>
</resources>
