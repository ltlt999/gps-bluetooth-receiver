<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingEnd="24dp"
    android:paddingTop="16dp">

    <com.google.android.material.switchmaterial.SwitchMaterial
        android:id="@+id/switchAutoStart"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/auto_start_title"
        android:textColor="@color/color_text_primary"
        android:textSize="15sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:paddingStart="4dp"
        android:text="@string/auto_start_summary"
        android:textAppearance="@style/TextAppearance.GpsReceiver.Body"
        android:textSize="12sp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="12dp"
        android:background="#223050" />

    <com.google.android.material.switchmaterial.SwitchMaterial
        android:id="@+id/switchMock"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/mock_title"
        android:textColor="@color/color_text_primary"
        android:textSize="15sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="8dp"
        android:paddingStart="4dp"
        android:text="@string/mock_summary"
        android:textAppearance="@style/TextAppearance.GpsReceiver.Body"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/tvMockStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:paddingStart="4dp"
        android:fontFamily="monospace"
        android:textIsSelectable="true"
        android:textSize="11sp"
        android:visibility="gone" />

    <com.google.android.material.switchmaterial.SwitchMaterial
        android:id="@+id/switchMockHold"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/mock_hold_title"
        android:textColor="@color/color_text_primary"
        android:textSize="15sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="8dp"
        android:paddingStart="4dp"
        android:text="@string/mock_hold_summary"
        android:textAppearance="@style/TextAppearance.GpsReceiver.Body"
        android:textSize="12sp" />
</LinearLayout>
