<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingTop="5dp"
    android:paddingBottom="5dp">

    <TextView
        android:id="@+id/tvSatPrn"
        android:layout_width="44dp"
        android:layout_height="wrap_content"
        android:fontFamily="monospace"
        android:gravity="center_vertical"
        android:textAppearance="@style/TextAppearance.GpsReceiver.Value"
        android:textSize="14sp" />

    <LinearLayout
        android:layout_width="76dp"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/ivSatFlag"
            android:layout_width="21dp"
            android:layout_height="14dp"
            android:contentDescription="@string/label_satellite_const"
            android:src="@drawable/flag_unknown" />

        <TextView
            android:id="@+id/tvSatConst"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:fontFamily="monospace"
            android:textColor="@color/color_text_secondary"
            android:textSize="11sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvSatSnr"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:fontFamily="monospace"
        android:textAppearance="@style/TextAppearance.GpsReceiver.Value"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/tvSatElev"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:fontFamily="monospace"
        android:textAppearance="@style/TextAppearance.GpsReceiver.Value"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/tvSatAzim"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:fontFamily="monospace"
        android:textAppearance="@style/TextAppearance.GpsReceiver.Value"
        android:textSize="14sp" />
</LinearLayout>
